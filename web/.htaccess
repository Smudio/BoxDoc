# =============================================================================
# BoxDoc — Apache-Konfiguration (optional)
# =============================================================================
# Diese Datei konfiguriert hübsche URLs und CORS. Falls der Webserver kein
# .htaccess unterstützt (nginx, etc.), können diese Regeln in die Server-Config
# übernommen werden. BoxDoc funktioniert auch ohne .htaccess, dann eben mit
# api.php?get=... URLs direkt.
# =============================================================================

# CORS für api.php und stream.php
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, X-BoxDoc-Token"
</IfModule>

# PUT-Methode erlauben (manche Hosts sind restriktiv)
<Limit GET POST PUT DELETE OPTIONS>
    Order allow,deny
    Allow from all
</Limit>

# Hübsche URLs: /d/<slug> → /index.php?doc=<slug>
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /d/<slug> → index.php
    RewriteRule ^d/([a-z0-9]{8,32})/?$ /index.php?doc=$1 [L,QSA]

    # /d/<slug>?t=<token> wird durch QSA automatisch weitergereicht
</IfModule>

# docs/ vor direktem Zugriff schützen
<IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order deny,allow
    Deny from all
</IfModule>

# Dateityp .boxdoc registrieren (für Download)
<IfModule mod_mime.c>
    AddType application/json .boxdoc
</IfModule>
